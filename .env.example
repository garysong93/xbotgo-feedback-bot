# Discord Bot 配置
# 请将此文件重命名为 .env 并填写以下信息

# Bot Token (从 Discord Developer Portal 获取)
DISCORD_TOKEN=your_bot_token_here

# Client ID (你的 Application ID)
CLIENT_ID=your_client_id_here

# Guild ID (XbotGo 服务器 ID)
GUILD_ID=1174640776358150236

# Feedback Channel ID (反馈消息发送到的频道 ID)
FEEDBACK_CHANNEL_ID=1432922752490274837
